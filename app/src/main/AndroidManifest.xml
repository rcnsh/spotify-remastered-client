<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The media notification (media/NowPlayingService) runs in the foreground while playing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Settings shows the installed Spotify app's version and can open it. -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:name=".RemasteredApp"
        android:label="Remastered"
        android:icon="@android:drawable/ic_media_play"
        android:theme="@style/Theme.Remastered"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- music-warehouse "Sign in with Spotify" (warehouse/WarehouseSignIn) returns here. Host
                 warehouse-auth, not callback: Spotify's auth AAR owns app.remastered://callback. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.remastered" android:host="warehouse-auth" />
            </intent-filter>
        </activity>
        <service
            android:name=".media.NowPlayingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Wrapped share images (cache/wrapped/*.png), handed to the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.wrapped"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/wrapped_share_paths" />
        </provider>
    </application>
</manifest>
