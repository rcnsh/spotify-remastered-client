<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The media notification (media/NowPlayingService) runs in the foreground while playing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Settings shows the installed Spotify app's version and can open it. -->
    <queries>
        <package android:name="com.spotify.music" />
        <!-- Sign-in opens in the browser's Custom Tab (ui/SignInScreen). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".RemasteredApp"
        android:label="Remastered"
        android:icon="@android:drawable/ic_media_play"
        android:theme="@style/Theme.Remastered"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Spotify's sign-in page (spotify/auth/SpotifyAuth) returns here: the redirect uri. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${redirectSchemeName}" android:host="${redirectHostName}" />
            </intent-filter>
            <!-- music-warehouse "Sign in with Spotify" (warehouse/WarehouseSignIn) returns here. Host
                 warehouse-auth, not callback: callback is the Spotify sign-in's redirect uri. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.remastered" android:host="warehouse-auth" />
            </intent-filter>
            <!-- Launcher shortcuts: Now playing, Liked Songs, Search (Wrapped is added at run time). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- Spotify's auth AAR claims the redirect uri for its login activity, which hands the login
             to the Spotify app (dropping PKCE); sign-in doesn't use it. -->
        <activity
            android:name="com.spotify.sdk.android.auth.LoginActivity"
            tools:node="remove" />
        <service
            android:name=".media.NowPlayingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- The home screen widget; its buttons go to the unexported receiver below. -->
        <receiver
            android:name=".media.NowPlayingWidget"
            android:exported="true"
            android:label="Now playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>
        <receiver
            android:name=".media.NowPlayingWidgetCommands"
            android:exported="false" />
        <!-- Share images (cache/wrapped/*.png: Wrapped and lyrics cards), handed to the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.wrapped"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/wrapped_share_paths" />
        </provider>
    </application>
</manifest>
